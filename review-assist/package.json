{
  "name": "review-assist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "assets/",
    "index.client.ts",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "scripts/",
    "package-lock.json"
  ],
  "scripts": {
    "postinstall": "npm run bundle-monaco && npm run build-mermaid && npm run build-client",
    "bundle-monaco": "node scripts/bundle-monaco.mjs",
    "build-mermaid": "node scripts/build-mermaid.mjs",
    "build-client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./tests/resolve-ts.ts --test tests/*.test.ts",
    "test:rn": "jest",
    "check": "npm run build-mermaid && npm run build-client && npm run typecheck && npm run test && npm run test:rn"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "^0.81.5",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/react-native": "^13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-classes": "^7.29.7",
    "@getpaseo/highlight": "0.12.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "marked": "^16.4.2",
    "mermaid": "^12.2.0",
    "monaco-editor": "0.57.0",
    "svgdom": "^0.1.29"
  }
}
