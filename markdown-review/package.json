{
  "name": "markdown-review",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build-client && npm run build-server",
    "build-client": "node kit/scripts/build.mjs client",
    "build-server": "node kit/scripts/build.mjs server",
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks --experimental-transform-types --no-warnings=ExperimentalWarning --import ./kit/scripts/resolve-ts.ts --test tests/*.test.ts",
    "test:rn": "jest",
    "check": "npm run build-client && npm run build-server && npm run typecheck && npm run test && npm run test:rn"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.13.0",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "^0.81.5",
    "@tanstack/react-query": "^5.90.11",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-classes": "^7.29.7",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "marked": "^16.4.2"
  }
}
